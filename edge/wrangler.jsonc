{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codeskyline",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Served at the apex: codeskyline.dev/owner/repo. Cloudflare issues the
  // certificate and DNS record on deploy.
  "routes": [{ "pattern": "codeskyline.dev", "custom_domain": true }],

  // The viewer. Built assets never touch the Worker (and are free); page
  // paths run it first so /owner/repo gets its link preview.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/samples/*"]
  },

  "vars": {
    "MAX_REPO_KB": "2000000",
    "MAX_COMMITS": "100000",
    "MAX_JOBS_PER_MONTH": "2000",
    "PUBLIC_ORIGIN": "https://codeskyline.dev"
  },

  "durable_objects": {
    "bindings": [
      { "name": "JOB", "class_name": "JobDO" },
      { "name": "ANALYZER", "class_name": "AnalyzerContainer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobDO", "AnalyzerContainer"] }],

  // The analyzer. Under the "durable_object" scheduling policy each Durable
  // Object picks the image and instance size when it starts its container
  // (AnalyzerContainer in src/container.ts); concurrency is capped by
  // ANALYZER_SHARDS, since there is no max_instances here.
  "containers": [
    {
      "class_name": "AnalyzerContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "analyzer": { "dockerfile": "../analyzer/Dockerfile", "build_context": "../analyzer" }
      }
    }
  ],

  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "codeskyline-analysis" }],
    "consumers": [
      {
        "queue": "codeskyline-analysis",
        "max_batch_size": 1,
        "max_concurrency": 4,
        "max_retries": 1,
        "dead_letter_queue": "codeskyline-dlq"
      }
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codeskyline",
      "database_id": "cfb0f54b-17f7-4ab5-abae-78d68fb68004",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "CITIES", "bucket_name": "codeskyline-cities" }],

  "ratelimits": [
    { "name": "ANALYZE_RL", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ]
}
